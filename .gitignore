# ============================================================
# server 仓库 .gitignore —— 敏感内容红线
# 原则：真实密钥/密码/私钥永不入库；模板（.env.example）值必须为空
# ============================================================

# ---- 环境变量：真实值一律忽略，仅保留空值模板 ----
.env
.env.*
!.env.example

# ---- 构建产物 ----
target/
*.jar

# ---- 密钥与证书（任何形态都不入库）----
*.pem
*.key
*.p12
*.jks
id_rsa*
*.pfx

# ---- 日志 ----
*.log
logs/

# ---- IDE / 系统 ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# nginx 部署参考：SSL 私钥/证书为敏感信息，禁止入库
nginx/ssl/
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/conf.d/wheretogo.conf
