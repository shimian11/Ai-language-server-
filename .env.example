# ============================================
# 复制为 .env 并填入真实值；.env 不入库
# 本地：IDEA EnvFile 插件注入
# 线上：docker-compose env_file 注入
# 所有键一律留空（KEY=），不含任何真实值/示例值/基础设施信息
# ============================================

# ---- PostgreSQL ----
PG_HOST=
PG_PORT=
PG_DATABASE=
PG_USERNAME=
PG_PASSWORD=

# ---- SSH 隧道（仅 local profile 生效）----
SSH_TUNNEL_ENABLED=
SSH_HOST=
SSH_USER=
SSH_PRIVATE_KEY=

# ---- MinIO ----
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# ---- JWT（敏感，长度 ≥32 字符）----
JWT_SECRET=
JWT_EXPIRE_DAYS=

# ---- 管理员账号 ----
ADMIN_USERNAME=
ADMIN_PASSWORD=
