# ============================================
# 复制为 .env 并填入真实值；.env 不入库
# 本地：IDEA EnvFile 插件注入
# 线上：docker-compose env_file 注入
# ============================================

# ---- PostgreSQL（复用 wheretogo 的 PG 容器，库名 ailang 独立隔离）----
# 本地：docker 起 ailang-pg 或 SSH 隧道（远程 5432 → 本地 5432），填 127.0.0.1
# 线上：PG_HOST 填 wheretogo-postgres（wheretogo docker 网络内容器名）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=ailang
PG_USERNAME=ailang
PG_PASSWORD=

# ---- MinIO ----
# 本地：http://127.0.0.1:9000
# 线上：填浏览器可达的公网地址（预签名直传用），https://s3.where2go.xyz
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ailang-images

# ---- JWT ----
# 敏感，长度 ≥32 字符
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# ---- 管理员账号 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
