# ============================================
# 复制为 .env 并填入真实值；.env 不入库
# 本地：IDEA EnvFile 插件注入
# 线上：docker-compose env_file 注入
# ============================================

# ---- PostgreSQL（复用 wheretogo 的 PG 容器，库名 ailang 独立隔离）----
# 本地：后端启动时 SshConfig 自动建立 SSH 隧道（本地 15432 → 服务器 5432），填 127.0.0.1
# 线上：PG_HOST 填 wheretogo-postgres（wheretogo docker 网络内容器名，端口固定 5432 由 prod profile 写死）
PG_HOST=127.0.0.1
PG_PORT=15432
PG_DATABASE=ailang
PG_USERNAME=ailang
PG_PASSWORD=

# ---- SSH 隧道（仅 local profile 生效，SshConfig 启动时自动建立）----
SSH_TUNNEL_ENABLED=true
SSH_HOST=8.134.91.151
SSH_USER=root
SSH_PRIVATE_KEY=            # 可空，默认 ~/.ssh/id_rsa

# ---- MinIO ----
# 本地：直连服务器公网入口（预签名直传即真实链路），https://s3.where2go.xyz
# 本地起独立 MinIO 时填 http://127.0.0.1:9000
MINIO_ENDPOINT=https://s3.where2go.xyz
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ailang-images

# ---- JWT ----
# 敏感，长度 ≥32 字符
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# ---- 管理员账号 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
